# ==============================================================================
# Resume Builder Backend - Environment Configuration (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String
# Leave blank or commented out to use the built-in MongoMemoryServer in-memory fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumebuilder?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=supersecret_jwt_key_replace_in_production
